    "lab:tools": "node scripts/lab-tools.mjs",
    "setup": "node scripts/setup-lab.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "agentation": "^3.0.2",
    "align-ui": "github:ViShEsHK2412/align-ui",
    "dialkit": "^2.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
