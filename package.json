{
  "name": "interaction-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Figma-style infinite canvas that hosts fully interactive app screens.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
